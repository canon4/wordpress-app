# ============================================================
# Copia este archivo como .env y rellena los valores reales
# ============================================================
# IMPORTANTE:
#  - Este archivo NO debe montarse dentro de /var/www/html (la raíz web).
#    Las variables entran al contenedor por `env_file`; montarlo como
#    archivo lo deja servible por HTTP.
#  - Usa contraseñas largas y únicas (openssl rand -base64 24).
#  - NUNCA expongas MySQL a internet. Para conectarte a la base de producción
#    desde tu máquina usa un túnel SSH:
#        ssh -L 3307:127.0.0.1:3306 usuario@servidor
#    y apunta tu WordPress local a 127.0.0.1:3307.

# Base de datos
# PROD: nombre del contenedor MySQL en la red compartida "red_global" (mysql_global)
# DEV:  127.0.0.1:3307 (túnel SSH, ver arriba)
WORDPRESS_DB_HOST=mysql_global
WORDPRESS_DB_NAME=
WORDPRESS_DB_USER=
WORDPRESS_DB_PASSWORD=

# URL del sitio
# DEV:  https://sensation-foam-frostily.ngrok-free.dev
# PROD: https://amazoniamarket.zogui.cloud
WP_HOME=https://amazoniamarket.zogui.cloud
WP_SITEURL=https://amazoniamarket.zogui.cloud
